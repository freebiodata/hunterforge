---
interface Props {
  /** Search term for the community wiki. */
  term: string;
  small?: boolean;
}
const { term, small } = Astro.props;
const url = `https://monsterhunterwilds.wiki.gg/wiki/Special:Search?search=${encodeURIComponent(term)}`;
---

<a
  class={`btn btn--ghost ${small ? 'btn--small' : ''}`}
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  title="Cross-check on the community wiki (opens in a new tab)"
>
  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
    <polyline points="15 3 21 3 21 9"></polyline>
    <line x1="10" y1="14" x2="21" y2="3"></line>
  </svg>
  wiki
</a>
