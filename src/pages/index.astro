---
import Base from '../layouts/Base.astro';
import DataBanner from '../components/DataBanner.astro';
import { meta } from '../data/meta';
import { skills } from '../data/skills';
import { setBonuses } from '../data/sets';
import { icons } from '../lib/icons';

const description =
  'Free Monster Hunter Wilds build calculator: armor set builder with skill caps, decoration planner, and effective raw calculator. High-rank data from game files, gaps flagged honestly.';
---

<Base title="Monster Hunter Wilds Build & Skill Calculators | HunterForge" description={description} path="/">
  <section class="hero">
    <p class="kicker mono" style="color:var(--ember); letter-spacing:.2em; text-transform:uppercase; font-size:.8rem; margin:0 0 .6rem;">
      Forge the perfect hunt
    </p>
    <h1>Monster Hunter Wilds<br /><span class="accent">build &amp; skill calculators</span></h1>
    <p class="lede">
      Plan high-rank armor sets, fit decorations into the right slots, and compare weapons by effective raw - 
      with every number traced to game-file data and every gap in the dataset shown, not hidden.
    </p>
    <div class="actions">
      <a class="btn btn--ember" href="/builder">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 L12 22 M2 12 L22 12" opacity="0"/><path d="M9 3h6l1 4h4l-3 5 2 9H5l2-9L4 7h4z"/></svg>
        Open the Set Builder
      </a>
      <a class="btn btn--ghost" href="/eraw">Effective Raw Calculator</a>
      <a class="btn btn--ghost" href="/decorations">Decoration Planner</a>
    </div>
    <div class="badges">
      <span class="snapshot-chip"><span class="dot"></span> snapshot {meta.snapshotDate}</span>
      <span class="badge">{meta.coverage.highRankArmorPieces} HR armor pieces</span>
      <span class="badge">{meta.coverage.skillsTotal} skills with caps</span>
      <span class="badge">{meta.coverage.decorations} decorations</span>
      <span class="badge">{setBonuses.length} set bonuses · {meta.coverage.charmRanks} charms</span>
    </div>
  </section>

  <div class="tape" role="presentation"></div>

  <DataBanner
    note={`Snapshot ${meta.snapshotDate}: all ${meta.coverage.highRankArmorPieces} high-rank armor pieces, ${meta.coverage.skillsTotal} skills, ${meta.coverage.decorations} decorations and ${meta.coverage.charmRanks} charm ranks from game-file data. Low-rank gear and deco crafting materials are not included.`}
  />

  <h2 style="margin-top:2.2rem;">Three tools, one forge</h2>
  <div class="tools-grid">
    <a class="tool-card" href="/builder">
      <span class="tool-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a4 4 0 0 0-4 4v1H6l-1 5h14l-1-5h-2V6a4 4 0 0 0-4-4z"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/><path d="M9 21v-4h6v4"/></svg>
      </span>
      <h2>Armor Set Builder</h2>
      <p>
        Equip 5 pieces plus a charm, search armor by skill, slot decorations, and get the full skill table
        with level caps, wasted levels, set bonus thresholds and group skills - computed live.
      </p>
      <span class="go">Build a set <Fragment set:html={icons.chevron} /></span>
    </a>
    <a class="tool-card" href="/decorations">
      <span class="tool-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9z"/><path d="M2 9h20"/><path d="M9 3l3 6 3-6"/><path d="M12 9v12" opacity=".5"/></svg>
      </span>
      <h2>Decoration Planner</h2>
      <p>
        Look up which jewels grant a skill, what slot levels they need, and get a farm list for a whole
        target skill plan - including skills that have no decoration at all.
      </p>
      <span class="go">Plan decos <Fragment set:html={icons.chevron} /></span>
    </a>
    <a class="tool-card" href="/eraw">
      <span class="tool-icon" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2l-8 12h6l-2 8 10-14h-6l2-6z"/></svg>
      </span>
      <h2>Effective Raw Calculator</h2>
      <p>
        Weapon raw × affinity × Critical Boost × sharpness multiplier, with the formula shown step by step
        and all seven sharpness tiers compared. Sharpness values cited from the community.
      </p>
      <span class="go">Compute ERaw <Fragment set:html={icons.chevron} /></span>
    </a>
  </div>

  <div class="stat-strip">
    <div class="stat"><div class="num">{meta.coverage.highRankArmorPieces}</div><div class="lbl">HR armor pieces</div></div>
    <div class="stat"><div class="num">{meta.coverage.armorSets}</div><div class="lbl">set bonuses</div></div>
    <div class="stat"><div class="num">{meta.coverage.skillsTotal}</div><div class="lbl">skills with max caps</div></div>
    <div class="stat"><div class="num">{meta.coverage.armorDecorations}</div><div class="lbl">armor decorations</div></div>
    <div class="stat"><div class="num">{meta.coverage.charmRanks}</div><div class="lbl">charm ranks</div></div>
  </div>

  <div class="grid-2" style="margin-top:1.8rem;">
    <div class="card">
      <h3 style="display:flex; align-items:center; gap:.5rem;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ember)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
        Honest by design
      </h3>
      <p style="color:var(--bone-dim); margin-bottom:0;">
        The dataset is a labeled snapshot: what it includes, when it was taken, and where each number came
        from are shown on every tool. Unknown rows are flagged in the interface - never silently dropped.
        Sharpness multipliers are cross-confirmed against the community wiki and cited.
      </p>
    </div>
    <div class="card">
      <h3 style="display:flex; align-items:center; gap:.5rem;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--ember)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        New to Wilds skill math?
      </h3>
      <p style="color:var(--bone-dim); margin-bottom:0;">
        Skills stack additively up to their max level; set bonuses fire at 2 and 4 pieces of a family;
        group skills fire at 3 pieces sharing the skill name; affinity modifies raw by ±25% (±40% with
        Critical Boost Lv5). The <a href="/faq">FAQ</a> walks through all of it.
      </p>
    </div>
  </div>
</Base>
