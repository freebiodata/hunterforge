---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = 'Site Map';
const description = 'Every page on HunterForge: tools, reference pages, trust and legal pages.';

const groups = [
  {
    name: 'Tools',
    links: [
      { href: '/builder', label: 'Armor Set Builder - equip pieces and a charm, read capped skill totals' },
      { href: '/decorations', label: 'Decoration Planner - which jewels to farm for a skill plan' },
      { href: '/eraw', label: 'Effective Raw Calculator - raw × affinity × sharpness, step by step' },
    ],
  },
  {
    name: 'Reference',
    links: [
      { href: '/skills', label: 'Skill Library - every Wilds skill with max levels and effects' },
      { href: '/faq', label: 'FAQ - skill stacking, caps, set bonuses and ERaw explained' },
      { href: '/about', label: 'Data Sources & Methodology - snapshots, citations and known gaps' },
    ],
  },
  {
    name: 'Trust & legal',
    links: [
      { href: '/changelog', label: 'Changelog - dated, real updates' },
      { href: '/privacy', label: 'Privacy Policy - nothing is collected' },
      { href: '/terms', label: 'Terms of Use - as-is fan tool, Capcom disclaimer' },
    ],
  },
];
---

<Base title={title} description={description} path="/sitemap">
  <Breadcrumbs items={[{ name: 'Site Map' }]} />
  <div class="page-head">
    <p class="kicker">Utility</p>
    <h1>Site Map</h1>
    <p class="lede">Every page on HunterForge, one click from everywhere. The XML sitemap lives at <a href="/sitemap-index.xml">/sitemap-index.xml</a>.</p>
  </div>

  <div class="grid-2" style="gap:1rem;">
    {groups.map((g) => (
      <section class="card">
        <h2 style="font-size:1rem;">{g.name}</h2>
        <ul style="list-style:none; margin:0; padding:0;">
          {g.links.map((l) => (
            <li style="padding:.35rem 0; border-bottom:1px dashed var(--line);">
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <section class="card">
      <h2 style="font-size:1rem;">Home</h2>
      <ul style="list-style:none; margin:0; padding:0;">
        <li><a href="/">HunterForge home - all tools and dataset status</a></li>
      </ul>
    </section>
  </div>
</Base>
