---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Faq {
  q: string;
  a: string; // HTML allowed
}

const faqs: Faq[] = [
  {
    q: 'How do skill levels stack in Monster Hunter Wilds?',
    a: `Additively, up to each skill's cap. Every armor piece, charm, decoration and set bonus that grants a skill adds its levels together - two pieces giving Latent Power Lv2 each put you at Lv4. Once the total passes the skill's maximum (shown on every skill card in the <a href="/skills">skill library</a>), the extra levels are wasted: the builder marks them with a red "wasted" badge so you can trade that piece or deco for something else. Skill levels from set bonuses and group skills stack with everything else, but the bonuses themselves only activate at their piece thresholds (2/4 pieces for set bonuses, 3 pieces sharing a group skill).`,
  },
  {
    q: 'What is effective raw (ERaw)?',
    a: `A single number that folds a weapon's attack and affinity (and sharpness) into one comparison metric:
    <span class="mono">ERaw = Raw × (1 + Affinity% × CritBonus) × SharpnessMultiplier</span>.
    Affinity is the chance to crit: crits deal 125% damage (140% with Critical Boost Lv5), so 40% affinity is worth +10% raw on average. Negative affinity works in reverse with a fixed 75% penalty. Multiply by the sharpness tier (Blue ×1.20, White ×1.32, Purple ×1.39) and you can compare, say, a high-raw low-affinity hammer against a low-raw high-affinity one. It deliberately excludes motion values, hitzones and quest modifiers - those vary per attack and per monster, which is why the <a href="/eraw">ERaw calculator</a> is scoped to weapon quality only.`,
  },
  {
    q: 'What data is HunterForge built on, and how fresh is it?',
    a: `The armor, skill, decoration and charm datasets come from <a href="https://wilds.mhdb.io/en" target="_blank" rel="noopener noreferrer">wilds.mhdb.io</a>, a database extracted directly from the game files, snapshotted on <strong>2026-10-11</strong> (the date is shown on every page). Sharpness multipliers are hand-verified against the Fextralife wiki and community sources, and cited on the <a href="/eraw">ERaw page</a>. The full source list and methodology live on the <a href="/about">data &amp; sources page</a>.`,
  },
  {
    q: 'Why do some armor pieces have decoration slots and others none?',
    a: `That's the game, not a data gap. In the current title-update era of Wilds, armor pieces have zero to three decoration slots depending on the piece; 512 of the 582 high-rank pieces in the snapshot have at least one. Pieces with more or bigger slots usually carry fewer built-in skill levels - that's the trade the builder makes visible.`,
  },
  {
    q: 'Can I use armor decorations in weapon slots (or the reverse)?',
    a: `No - Wilds splits decorations into armor jewels and weapon jewels, and each kind only fits its own slot type. On top of that, a jewel needs a slot at least its own level: a [3] jewel fits a Lv3 slot only, a [1] jewel fits any slot. The builder refuses invalid placements and tells you why; the <a href="/decorations">decoration planner</a> shows the slot budget for any target plan.`,
  },
  {
    q: 'What are set bonuses and group skills?',
    a: `Set bonuses (gold badge) belong to armor families - Rey Dau, Arkveld, Gore Magala and so on - and activate at 2 and 4 equipped pieces of that family, with α/β/γ variants counting together. Group skills (moss badge) are printed on pieces ("Fortifying Pelt", "Lord's Favor"…): any 3 equipped pieces carrying the <em>same group skill name</em> activate it, even from different monster sets. The builder tracks both live, including progress toward the next threshold.`,
  },
  {
    q: "Why doesn't the site show exact damage numbers per hit?",
    a: `Honesty over false precision. True hit damage = raw × motion value ÷ class modifier × sharpness × hitzone × quest modifier (plus elemental terms). Motion values depend on the specific attack animation of each of the 14 weapon types and hitzones vary per monster part and wound state. A single-answer "damage calculator" without those inputs would be wrong by design, so HunterForge computes ERaw - everything that depends on the weapon and skills, nothing that depends on the hit. The sharpness table and formula are cited so you can take it further yourself.`,
  },
  {
    q: 'Is HunterForge free? Does it track me?',
    a: `Free, no ads, no accounts. Builds live in your browser (localStorage) and in share links - there is no server-side storage and no analytics. The site is static; the only network requests are loading the page itself.`,
  },
];

const title = 'MH Wilds Skill Math FAQ: Stacking, Caps & ERaw';
const description =
  'How skill levels stack and cap in Monster Hunter Wilds, what effective raw means, how set bonuses and group skills work, and where HunterForge data comes from.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};
---

<Base title={title} description={description} path="/faq">
  <Breadcrumbs items={[{ name: 'FAQ' }]} />
  <div class="page-head">
    <p class="kicker">Reference</p>
    <h1>Frequently Asked Questions</h1>
    <p class="lede">The Wilds skill math this site is built on - stacking, caps, set bonuses, and what effective raw actually measures.</p>
  </div>

  <div style="max-width:840px;">
    {faqs.map((f) => (
      <details class="faq" open={faqs.indexOf(f) < 2}>
        <summary>{f.q}</summary>
        <div class="faq-body" set:html={f.a} />
      </details>
    ))}
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>
